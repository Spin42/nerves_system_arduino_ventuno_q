From: Loïc Vigneron <loic@spin42.com>
Subject: [PATCH] net: stmmac: qcom-ethqos: Restart the interface after a switch to 2500BASE-X

The QCA8081 switches its host interface from SGMII to 2500BASE-X when
the link goes from 1 Gbps to 2.5 Gbps. After that switch on a running
interface the MAC passes no frames in either direction; the MAC and DMA
registers match those of a working link, retuning or power cycling the
SerDes does not help, and only reopening the interface, which resets the
MAC, does. The switch back to SGMII works. Schedule a close and reopen
of the interface when the resolved interface changes to 2500BASE-X.
---
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
@@ -7,6 +7,8 @@
 #include <linux/platform_device.h>
 #include <linux/phy.h>
 #include <linux/phy/phy.h>
+#include <linux/rtnetlink.h>
+#include <linux/workqueue.h>
 
 #include "stmmac.h"
 #include "stmmac_platform.h"
@@ -99,6 +101,7 @@
 
 struct qcom_ethqos {
 	struct platform_device *pdev;
+	struct work_struct restart_work;
 	void __iomem *rgmii_base;
 	struct clk *link_clk;
 	struct phy *serdes_phy;
@@ -646,6 +649,8 @@
 				    phy_interface_t interface)
 {
 	struct qcom_ethqos *ethqos = priv;
+	bool to_2500basex = interface == PHY_INTERFACE_MODE_2500BASEX &&
+			    ethqos->phy_mode != PHY_INTERFACE_MODE_2500BASEX;
 	int ret = 0;
 
 	qcom_ethqos_set_sgmii_loopback(ethqos, false);
@@ -661,9 +666,42 @@
 		ret = phy_set_mode_ext(ethqos->serdes_phy, PHY_MODE_ETHERNET,
 				       interface);
 
+	/* After a switch from SGMII to 2500BASE-X on a running interface the
+	 * MAC passes no frames until it is reset, which opening the interface
+	 * does; the reverse switch is fine.
+	 */
+	if (!ret && to_2500basex && netif_running(ndev))
+		schedule_work(&ethqos->restart_work);
+
 	return ret;
 }
 
+static void ethqos_restart_work(struct work_struct *work)
+{
+	struct qcom_ethqos *ethqos = container_of(work, struct qcom_ethqos,
+						  restart_work);
+	struct net_device *ndev = platform_get_drvdata(ethqos->pdev);
+
+	int ret;
+
+	rtnl_lock();
+	if (netif_running(ndev)) {
+		netdev_info(ndev, "restarting after the switch to 2500BASE-X\n");
+		dev_close(ndev);
+		ret = dev_open(ndev, NULL);
+		if (ret)
+			netdev_err(ndev, "reopening failed: %d\n", ret);
+	}
+	rtnl_unlock();
+}
+
+static void ethqos_cancel_restart(void *data)
+{
+	struct qcom_ethqos *ethqos = data;
+
+	cancel_work_sync(&ethqos->restart_work);
+}
+
 static int ethqos_clks_config(void *priv, bool enabled)
 {
 	struct qcom_ethqos *ethqos = priv;
@@ -790,6 +828,8 @@
 		return dev_err_probe(dev, PTR_ERR(ethqos->serdes_phy),
 				     "Failed to get serdes phy\n");
 
+	INIT_WORK(&ethqos->restart_work, ethqos_restart_work);
+
 	ethqos_set_clk_tx_rate(ethqos, NULL, plat_dat->phy_interface,
 			       SPEED_1000);
 
@@ -826,7 +866,14 @@
 	for (i = 1; i < plat_dat->tx_queues_to_use; i++)
 		plat_dat->tx_queues_cfg[i].tbs_en = 1;
 
-	return devm_stmmac_pltfr_probe(pdev, plat_dat, &stmmac_res);
+	ret = devm_stmmac_pltfr_probe(pdev, plat_dat, &stmmac_res);
+	if (ret)
+		return ret;
+
+	/* Added after the net device so that, on removal, the work is
+	 * cancelled before the net device goes away.
+	 */
+	return devm_add_action_or_reset(dev, ethqos_cancel_restart, ethqos);
 }
 
 static const struct of_device_id qcom_ethqos_match[] = {
