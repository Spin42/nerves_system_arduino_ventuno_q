# Applied on top of the arm64 defconfig.

# Nerves application partition
CONFIG_F2FS_FS=y
# VintageNet gives each interface its own routing table
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# LED triggers the official Nerves systems enable. Delux needs pattern.
CONFIG_LEDS_TRIGGER_ACTIVITY=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_PATTERN=y

# Suppliers that defer USB, PCIe, Ethernet, the GPU and CPU frequency scaling
# until loaded, built in so their consumers probe at boot
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_SGMII_ETH=y
CONFIG_SA_GPUCC_8775P=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_QCOM_PD_MAPPER=y

# 2.5 GbE: the QCA8081 PHY on the ETHQOS controller
CONFIG_PHYLINK=y
CONFIG_PCS_XPCS=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_QCOM_ETHQOS=y
CONFIG_QCA808X_PHY=y

# Ethernet gadget for usb0 networking on the USB-C port
CONFIG_USB_ETH=y

# /sys/devices/soc0/serial_number, the board's serial number
CONFIG_QCOM_SOCINFO=y

# Raspberry Pi Global Shutter (IMX296) and HQ (IMX477) cameras on CAMSS
CONFIG_VIDEO_IMX296=m
CONFIG_VIDEO_IMX477=m

# The USB-C PD controller negotiates on its own; its UCSI driver only floods
# the I2C bus and the log with GET_CABLE_PROPERTY errors on this board.
# CONFIG_UCSI_CCG is not set

# /dev/i2c-* for i2c-tools
CONFIG_I2C_CHARDEV=y

# Fan controller and RGB LED controller on the CCI1 bus 1
CONFIG_SENSORS_EMC2305=y
CONFIG_LEDS_PCA963X=y
