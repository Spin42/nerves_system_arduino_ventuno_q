#!/bin/sh
#
# On some boots the Ethernet MAC receives no frames after the link first
# comes up, until eth0 is brought down and up; link renegotiation later on
# does not trigger it. This waits for the first link up and, if nothing is
# received in the window that follows, restarts eth0 (at most twice).

dev=eth0
net=/sys/class/net/$dev

log() {
    echo "ventuno-q-eth-watch: $*" > /dev/kmsg
}

wait_for_carrier() {
    i=0
    while [ "$i" -lt 120 ]; do
        [ "$(cat "$net/carrier" 2>/dev/null)" = 1 ] && return 0
        i=$((i + 1))
        sleep 1
    done
    return 1
}

[ -e "$net" ] || exit 0

attempt=0
while [ "$attempt" -lt 2 ]; do
    wait_for_carrier || exit 0
    sleep 10
    before=$(cat "$net/statistics/rx_packets")
    sleep 20
    after=$(cat "$net/statistics/rx_packets")
    if [ "$after" -gt "$before" ]; then
        exit 0
    fi
    attempt=$((attempt + 1))
    log "no frames received in 20 s with the link up, restarting $dev"
    ip link set dev "$dev" down
    sleep 1
    ip link set dev "$dev" up
done
log "still no frames received on $dev"
