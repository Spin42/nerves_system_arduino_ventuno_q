#!/bin/sh
#
# Starts the sketch on the STM32H5F5. Arduino's loader waits for a magic
# value in the MCU's backup SRAM before running a sketch flagged to wait for
# its app; it brings up the USB device (gs_usb CAN and a CDC ACM serial port)
# once running.

log() {
    echo "ventuno-q-mcu: $*" > /dev/kmsg
}

if ! out=$(openocd -f /usr/share/ventuno-q/mcu-swd.cfg -c init \
        -c "mww 0x40036400 0xCAFFEEEE" -c shutdown 2>&1); then
    log "openocd failed: $(echo "$out" | grep Error)"
fi

# OpenOCD leaves the SWD and reset lines driven; release them so that the
# MCU can reset itself.
gpioget gpiochip2 70 71 78 > /dev/null
